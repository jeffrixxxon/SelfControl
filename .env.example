# === Обязательно ===
# Токен от @BotFather
BOT_TOKEN=
# Домен, направленный на IP вашего VPS (A-запись). Caddy сам выпустит HTTPS-сертификат.
DOMAIN=selfcontrol.example.ru
WEBAPP_URL=https://selfcontrol.example.ru
# Ключ Claude API: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Пароль для Postgres (придумайте длинный)
POSTGRES_PASSWORD=change-me

# === Доступ ===
# Пусто — бот открыт всем. Или список Telegram ID через запятую (узнать свой ID: @userinfobot)
ALLOWED_USER_IDS=

# === Claude ===
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=2048
HISTORY_MESSAGES=20

# === Голосовые ===
# local — faster-whisper прямо на сервере (бесплатно, нужно ~2 ГБ RAM для модели small)
# openai — Whisper API (нужен OPENAI_API_KEY, ~$0.006 за минуту)
TRANSCRIBE_PROVIDER=local
WHISPER_MODEL=small
OPENAI_API_KEY=

# === Значения по умолчанию для новых пользователей ===
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_CURRENCY=RUB

# === Локальная разработка (без Telegram) ===
DEBUG=false
DEV_TG_ID=0
